{
  "tsconfig": "./tsconfig.build.json",
  "includeVersion": true,
  "excludeExternals": true,
  "sort": [
    "source-order"
  ],
  "sortEntryPoints": false,
  "categorizeByGroup": true,
  "groupOrder": [
    "Variables",
    "Interfaces",
    "Type Aliases",
    "*"
  ],
  "useFirstParagraphOfCommentAsSummary": true,
  "favicon": "https://metreeca.com/assets/icon.ico",
  "sourceLinkExternal": true,
  "markdownLinkExternal": true,
  "navigationLinks": {
    "GitHub": "https://github.com/metreeca/flow"
  },
  "externalSymbolLinkMappings": {
    "@metreeca/core": {
      "ascending": "https://metreeca.github.io/core/functions/order.ascending.html",
      "Awaitable": "https://metreeca.github.io/core/types/async.Awaitable.html",
    "Awaitables": "https://metreeca.github.io/core/types/async.Awaitables.html",
      "immutable": "https://metreeca.github.io/core/functions/structures.immutable.html",
      "Primitive": "https://metreeca.github.io/core/types/index.Primitive.html"
    },
    "global": {
      "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError"
    },
    "typescript": {
      "Error": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Error",
      "TypeError": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/TypeError"
    }
  },
  "githubPages": false,
  "hideGenerator": true,
  "customFooterHtml": "<a href='https://www.metreeca.com/' style='display: flex; align-items: center; gap: 0.25em'><img src='https://metreeca.com/assets/icon.svg' alt='Metreeca' style='width: 1.25em; height: 1.25em;'/><span>Copyright © 2025-2026 Metreeca</span></a>",
  "headings": {
    "readme": false
  }
}
