{
  "name": "@metreeca/flow",
  "version": "0.10.0",
  "description": "Composable primitives for asynchronous data flows.",
  "keywords": [
    "typescript",
    "utilities"
  ],
  "homepage": "https://metreeca.github.io/flow/",
  "bugs": {
    "url": "https://github.com/metreeca/flow/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/flow.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./feeds": "./dist/feeds/index.js",
    "./tasks": "./dist/tasks/index.js",
    "./sinks": "./dist/sinks/index.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && sh package.sh",
    "build": "rm -rf dist docs && npx tsc && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx five-server docs --open)"
  },
  "dependencies": {
    "@metreeca/core": "^0.10.0"
  },
  "devDependencies": {
    "five-server": "^0.4.5",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents": true
  }
}
